{
  "name": "lapa-ryadom",
  "version": "0.1.0",
  "private": true,
  "description": "«Лапа рядом» — сервис адресной вещевой помощи приютам для животных.",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run -w apps/api build && npm run -w apps/web build",
    "dev": "npm-run-all -p dev:api dev:web",
    "dev:api": "npm run -w apps/api dev",
    "dev:web": "npm run -w apps/web dev",
    "test": "npm run -w apps/api test",
    "lint": "npm run -w apps/api lint && npm run -w apps/web lint",
    "db:up": "node scripts/start-pg.mjs",
    "db:down": "node scripts/stop-pg.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "npm-run-all": "4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

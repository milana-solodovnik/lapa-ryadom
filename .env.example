# Postgres (source / development target) — see scripts/start-pg.mjs
DATABASE_URL=postgres://lapa:lapa@127.0.0.1:55432/lapa

# Target Digital Q.DataBase (production / demo). Leave empty until instance exists.
TARGET_DATABASE_URL=

# Server-only HMAC secret for generating offer codes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SERVER_OFFER_SECRET=replace-me-with-a-32-byte-base64url-secret

# Session cookie name and lifetime
SESSION_COOKIE_NAME=lapa_sid
SESSION_TTL_HOURS=8

# Demo-only password seeds (admin / shelter managers). Never commit real values.
DEMO_ADMIN_PASSWORD=change-me
DEMO_REP_A_PASSWORD=change-me
DEMO_REP_B_PASSWORD=change-me
DEMO_REP_C_PASSWORD=change-me

# API port
PORT=4000

# CORS origin for the web client
WEB_ORIGIN=http://localhost:5173
